# Local engine is the default. Mock/Hugging Face require explicit opt-in.
TRYON_MODE=local
# An installed, running IDM-VTON Gradio engine with the /tryon API, on this computer.
TRYON_LOCAL_URL=
HF_SPACE_ID=yisol/IDM-VTON
HF_TOKEN=
# Exact trusted HTTPS hosts, comma-separated; add your Supabase project host.
TRYON_IMAGE_HOSTS=i.pinimg.com
