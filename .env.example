# Copier en `.env` à la racine du repo (jamais commité). Lu par apps/api et apps/extension.
# Une variable vide = la brique correspondante tourne en mode mock.

# ---------- apps/api ----------
PORT=8787
# Origines CORS autorisées, séparées par des virgules. Vide = toute extension chrome-extension://
# (pratique en dev). En démo : chrome-extension://<ID de l'extension>
CORS_ORIGINS=

# H Company — clé hk-... créée sur https://platform.eu.hcompany.ai/settings/api-keys
# Nom imposé par le SDK hai-agents : HAI_API_KEY (région EU par défaut)
HAI_API_KEY=
# Agent catalogue H (vérifier la liste : GET /api/v2/agents)
HAI_AGENT_ID=h/web-surfer-pro
# Vault H (logins marchands) du profil de démo — id non secret, les mots de passe restent chez H
HAI_DEMO_VAULT_ID=

# Bright Data — token API + nom de la zone SERP (dashboard Bright Data)
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_SERP_ZONE=serp_api1
# Recherche par image Google Lens (true/false). Désactivée : Bright Data renvoie no_local_parser
BRIGHTDATA_USE_LENS=

# Hugging Face : identification de la pièce sélectionnée dans l'épingle (vide → mock).
# Token « Inference Providers » : https://huggingface.co/settings/tokens
HF_TOKEN=
HF_VISION_MODEL=google/gemma-4-26B-A4B-it

# Supabase — la service_role key ne quitte JAMAIS le serveur
# En local : `npx supabase start` puis `npx supabase status` affiche l'URL et les clés.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Service d'essayage de Félix (services/tryon), ex. http://localhost:8000
TRYON_SERVICE_URL=

# Forcer les mocks (true/false). Sans valeur : mock auto si la clé/URL manque.
MOCK_ALL=
MOCK_BRIGHTDATA=
MOCK_HCOMPANY=
MOCK_TRYON=
MOCK_SUPABASE=
MOCK_VISION=

# ---------- apps/extension ----------
# URL de apps/api vue par l'extension (aussi ajoutée aux host_permissions du manifest)
API_URL=http://localhost:8787
# Origine de la plateforme où le client se connecte (recompiler l’extension après modification).
WEB_URL=http://localhost:3000
# true = l'extension simule l'API (dev sans back-end)
WXT_USE_MOCK_API=false
# Recherche Bright Data depuis l'extension (false → l'extension s'arrête aux mots-clés à copier).
WXT_ENABLE_SEARCH=false
# Optionnel : lien vers la console SERP Bright Data, affiché à côté des mots-clés.
WXT_SERP_CONSOLE_URL=

# ---------- apps/web (Next.js) ----------
# Next.js ne lit que apps/web/.env* : copier ces lignes dans apps/web/.env.local.
# API_URL est aussi l’adresse serveur de apps/api pour les routes photo du site (défaut http://localhost:8787).
# Publiques (envoyées au navigateur) : mêmes valeurs que SUPABASE_URL / SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement (jamais NEXT_PUBLIC_) : SUPABASE_SERVICE_ROLE_KEY et HAI_API_KEY ci-dessus,
# utilisées par la session de l'extension et le vault des comptes marchands. MOCK_HCOMPANY s'applique aussi.

# ---------- supabase/ (CLI) — dans supabase/.env, optionnel ----------
# Connexion Google : voir [auth.external.google] dans supabase/config.toml
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
